--------------------- nextjs ---------------------
# Membuat proyek Next.js dengan npm
mkdir nama-app
cd nama-app
npm init next-app@latest    
cd /workspace
bunx create-next-app@latest nama-app
# atau
bun create next-app nama-app

# Jalankan Next.js
cd nama-app
bun dev