FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# Basic update & essential tools + common pentest packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates sudo git curl wget build-essential gnupg2 \
      python3 python3-pip python3-venv golang-go openjdk-17-jre-headless \
      unzip socat nmap tshark wireshark-common wireshark net-tools iproute2 \
      metasploit-framework zaproxy nikto ruby-full perl libwww-perl \
      liblwp-protocol-https-perl vim docker.io docker-compose || true && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# sqlmap (git clone)
RUN git clone --depth 1 https://github.com/sqlmapproject/sqlmap /opt/sqlmap || true

# Sliver (best-effort build from source)
RUN git clone https://github.com/BishopFox/sliver /opt/sliver || true && \
    /bin/bash -lc "cd /opt/sliver && export GOPATH=/go && export PATH=$PATH:/usr/local/go/bin:$GOPATH/bin; GO111MODULE=on go build ./cli || true" || true

# Dionaea (best-effort attempt; often requires manual tweaks)
RUN apt-get update && apt-get install -y --no-install-recommends \
      libglib2.0-dev libssl-dev libsqlite3-dev libcurl4-openssl-dev \
      libffi-dev libev-dev libpcap-dev libevent-dev python3-dev cmake automake autoconf libtool || true && \
    git clone --depth 1 https://github.com/DinoTools/dionaea /opt/dionaea || true

# Create non-root user
RUN useradd -ms /bin/bash kali && echo "kali:kali" | chpasswd && adduser kali sudo || true

WORKDIR /root

# Notes:
# - This image is a "stoples" image that tries to include many pentest tools.
# - Some components (Sliver, Dionaea) are built best-effort and might need manual steps after container start.
# - To allow packet capture / host-level network access, run containers with --cap-add=NET_ADMIN and/or --privileged or --network=host.
ENTRYPOINT ["/bin/bash"]