# Database Configuration
# Copy file ini ke .env dan sesuaikan dengan environment kamu

# Local Docker (default - kalau di Codespace)
# DATABASE_URL=postgres://pguser:sisfo%401@postgres_pgdb/pgdb

# Remote dari HP Android (Termux) - ganti dengan URL Codespace kamu
# Format: postgres://pguser:sisfo%401@<CODESPACE_NAME>-5432.app.github.dev/pgdb
# Contoh:
# DATABASE_URL=postgres://pguser:sisfo%401@sturdy-space-guacamole-xxxxxx-5432.app.github.dev/pgdb
