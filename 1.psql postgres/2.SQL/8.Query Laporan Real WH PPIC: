Laporan stok harian lengkap:
----------------------------
SELECT 
    g.nama_gudang,
    z.nama_zona,
    b.kode_barang,
    b.nama_barang,
    b.satuan,
    SUM(s.stok_tersedia)  AS stok_tersedia,
    SUM(s.stok_reserved)  AS stok_reserved,
    SUM(s.stok_total)     AS stok_total,
    b.stok_minimum,
    CASE 
        WHEN SUM(s.stok_tersedia) = 0           THEN 'HABIS'
        WHEN SUM(s.stok_tersedia) <= b.stok_minimum THEN 'HAMPIR HABIS'
        ELSE 'AMAN'
    END AS status_stok
FROM stok s
INNER JOIN barang b       ON s.id_barang = b.id_barang
INNER JOIN gudang g       ON s.id_gudang = g.id_gudang
INNER JOIN lokasi_penyimpanan lp ON s.id_lokasi = lp.id_lokasi
INNER JOIN zona_gudang z  ON lp.id_zona = z.id_zona
GROUP BY 
    g.nama_gudang, z.nama_zona,
    b.id_barang, b.kode_barang, 
    b.nama_barang, b.satuan, b.stok_minimum
ORDER BY status_stok, g.nama_gudang;