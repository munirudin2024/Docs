-- Cek ukuran semua index
SELECT 
    schemaname,
    tablename,
    indexname,
    pg_size_pretty(pg_relation_size(indexrelid)) AS ukuran
FROM pg_stat_user_indexes
ORDER BY pg_relation_size(indexrelid) DESC;

-- Cek index yang tidak pernah dipakai (kandidat dihapus)
SELECT 
    indexrelname AS nama_index,
    relname AS nama_tabel,
    idx_scan AS jumlah_dipakai
FROM pg_stat_user_indexes
WHERE idx_scan = 0
ORDER BY relname;

-- Rebuild index yang sudah bloat
REINDEX INDEX idx_label_fefo;

-- Vacuum & analyze — update statistik query planner
VACUUM ANALYZE transaksi_masuk;
VACUUM ANALYZE label_item;
VACUUM ANALYZE stok;
```

