-- Alert kalau stok di bawah minimum
CREATE OR REPLACE FUNCTION cek_stok_minimum()
RETURNS TRIGGER AS $$
DECLARE
    v_stok_min INT;
    v_nama_barang VARCHAR;
BEGIN
    SELECT b.stok_minimum, b.nama_barang 
    INTO v_stok_min, v_nama_barang
    FROM barang b WHERE b.id_barang = NEW.id_barang;

    IF NEW.stok_tersedia <= v_stok_min THEN
        INSERT INTO notifikasi_alert 
            (jenis_alert, id_barang, pesan, level)
        VALUES (
            'STOK_MINIMUM',
            NEW.id_barang,
            'Stok ' || v_nama_barang || ' sudah di bawah minimum! Sisa: ' 
                || NEW.stok_tersedia,
            CASE WHEN NEW.stok_tersedia = 0 THEN 'CRITICAL' ELSE 'WARNING' END
        );
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_cek_stok_minimum
AFTER UPDATE ON stok
FOR EACH ROW EXECUTE FUNCTION cek_stok_minimum();
