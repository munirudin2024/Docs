FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    neovim \
    python3 \
    python3-pip \
    git \
    curl \
    sudo \
    ca-certificates \
    && pip3 install --no-cache-dir pynvim \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create non-root user 'dev' with uid/gid 1000 by default
RUN useradd -m -s /bin/bash dev || true && echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev

WORKDIR /workspace
USER dev
ENV HOME=/home/dev
ENTRYPOINT ["/bin/bash", "-lc", "tail -f /dev/null"]